{
  "expo": {
    "name": "ROVER",
    "slug": "rover-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rover.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ROVER needs camera access to capture your documents and profile photo.",
        "NSPhotoLibraryUsageDescription": "ROVER needs photo library access to upload your ride photos and documents.",
        "NSLocationWhenInUseUsageDescription": "ROVER needs location access to track your transport journey.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ROVER needs continuous location access for live tracking during active transports."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.rover.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": { "compileSdkVersion": 34, "targetSdkVersion": 34 }
        }
      ]
    ],
    "scheme": "rover"
  }
}
